import 'package:dartz/dartz.dart';
import 'package:dio/dio.dart';
import 'package:easy_localization/easy_localization.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:{{name.snakeCase()}}/core/app/error/failure.dart';
import 'package:{{name.snakeCase()}}/core/app/error/failure_types.dart';
import 'package:{{name.snakeCase()}}/core/app/localization/locale_keys.dart';
import 'package:{{name.snakeCase()}}/environment/flavor/flavor_config.dart';

final dioProvider = Provider<DioClient>((ref) {
  return DioClient();
});

class DioClient {
  late final Dio _dio;

  DioClient() {
    final config = FlavorConfig.instance.settings;

    _dio = Dio(
      BaseOptions(
        baseUrl: config.baseUrl,
        connectTimeout: const Duration(seconds: 30),
        receiveTimeout: const Duration(seconds: 30),
        headers: {'Content-Type': 'application/json'},
      ),
    );

    if (config.enableLogging) {
      _dio.interceptors.add(
        LogInterceptor(requestBody: true, responseBody: true),
      );
    }
  }

  Left<Failure, Never> _handleError(Object e) {
    if (e is DioException) {
      final type = switch (e.type) {
        DioExceptionType.connectionTimeout ||
        DioExceptionType.receiveTimeout ||
        DioExceptionType.sendTimeout => LocaleKeys.errors_remote_timeout.tr(),
        DioExceptionType.connectionError =>
          LocaleKeys.errors_remote_no_internet.tr(),
        DioExceptionType.badResponse =>
          '${e.response?.statusCode ?? LocaleKeys.errors_remote_error.tr()}',
        _ => LocaleKeys.errors_remote_error.tr(),
      };
      return Left(NetworkFailure(
        type: type,
        message: e.message ?? LocaleKeys.errors_remote_unknown.tr(),
      ));
    }
    return Left(UnknownFailure());
  }

  Future<Either<Failure, T>> _request<T>(
    Future<Response<dynamic>> Function() call, {
    required T Function(dynamic) fromJson,
  }) async {
    try {
      final response = await call();
      return Right(fromJson(response.data));
    } catch (e) {
      return _handleError(e);
    }
  }

  Future<Either<Failure, T>> get<T>(
    String path, {
    required T Function(dynamic) fromJson,
    Map<String, dynamic>? queryParameters,
    Options? options,
  }) async {
    return _request(
      () {
        return _dio.get(
          path,
          queryParameters: queryParameters,
          options: options,
        );
      },
      fromJson: fromJson,
    );
  }

  Future<Either<Failure, T>> post<T>(
    String path, {
    required T Function(dynamic) fromJson,
    dynamic data,
    Options? options,
  }) async {
    return _request(
      () {
        return _dio.post(path, data: data, options: options);
      },
      fromJson: fromJson,
    );
  }

  Future<Either<Failure, T>> put<T>(
    String path, {
    required T Function(dynamic) fromJson,
    dynamic data,
    Options? options,
  }) async {
    return _request(
      () {
        return _dio.put(path, data: data, options: options);
      },
      fromJson: fromJson,
    );
  }

  Future<Either<Failure, T>> patch<T>(
    String path, {
    required T Function(dynamic) fromJson,
    dynamic data,
    Options? options,
  }) async {
    return _request(
      () {
        return _dio.patch(path, data: data, options: options);
      },
      fromJson: fromJson,
    );
  }

  Future<Either<Failure, T>> delete<T>(
    String path, {
    required T Function(dynamic) fromJson,
    Options? options,
  }) async {
    return _request(
      () {
        return _dio.delete(path, options: options);
      },
      fromJson: fromJson,
    );
  }
}
